<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="window_background_light">#FFF3F4F6</color>
    <color name="window_background_dark">#FF111416</color>

    <style name="AppThemeDayNight" parent="Theme.AppCompat.DayNight">
        <item name="android:windowBackground">@color/window_background_light</item>
    </style>

    <style name="AppThemeDayNight.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background_light</item>
    </style>

    <style name="AppThemeDayNight.NoActionBar.Translucent" parent="AppThemeDayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
</resources>
